package analizador;

import java_cup.runtime.Symbol;
import java.util.Stack;
import java.util.ArrayList;
import java.util.List;

parser code 
{:
    private TablaSimbolos tablaSimbolos = new TablaSimbolos();
    private Stack<String> ambitos = new Stack<>();
    private List<String> erroresSemanticos = new ArrayList<>();
    private Symbol s;
    
    public void syntax_error(Symbol s) {
        this.s = s;
        System.out.println("Error sintáctico en línea " + (s.left+1));
    }

    public Symbol getS() {
        return this.s;
    }
    
    public boolean hayErrores() {
        return this.s != null || !erroresSemanticos.isEmpty();
    }
    
    public void imprimirErrores() {
        if (this.s != null) {
            System.out.println("Error sintáctico encontrado");
        }
        for (String error : erroresSemanticos) {
            System.out.println(error);
        }
    }
    
    private void agregarErrorSemantico(int linea, String mensaje) {
        erroresSemanticos.add("Error semántico [Línea " + linea + "]: " + mensaje);
    }
    
    private void declararVariable(String id, String tipo, int linea) {
        if (tablaSimbolos.existeSimbolo(id)) {
            agregarErrorSemantico(linea, "Variable '" + id + "' ya declarada");
        } else {
            tablaSimbolos.agregarSimbolo(id, tipo, ambitos.peek());
        }
    }
    
    private void verificarVariable(String id, int linea) {
        if (!tablaSimbolos.existeSimbolo(id)) {
            agregarErrorSemantico(linea, "Variable '" + id + "' no declarada");
        }
    }
    
    private void verificarTipo(String id, String tipoEsperado, int linea) {
        TablaSimbolos.Simbolo sim = tablaSimbolos.buscarSimbolo(id);
        if (sim != null && !sim.getTipo().equals(tipoEsperado)) {
            agregarErrorSemantico(linea, "Tipo incompatible en '" + id + "'. Esperado: " + 
                tipoEsperado + ", encontrado: " + sim.getTipo());
        }
    }
:};

/* Terminales simplificados */
terminal 
    /* Tipos de datos */
    Int, T_dato, Cadena,
    
    /* Palabras reservadas */
    If, Else, Do, While, For, 
    Public, Static, Void, Main, Class,
    Private, Default, Protect,
    
    /* Operadores */
    Igual, Suma, Resta, Multiplicacion, Division,
    Op_relacional, Op_atribucion, Op_booleano,
    
    /* Símbolos */
    Parentesis_a, Parentesis_c, Llave_a, Llave_c, 
    P_coma, Comillas,
    
    /* Identificadores y valores */
    Identificador, Numero
;

/* No terminales reorganizados */
non terminal 
    INICIO, CLASE, CUERPO_CLASE,
    SENTENCIAS, SENTENCIA, 
    DECLARACION, ASIGNACION, TIPO_VAR, 
    EXPRESION, VALOR, CONDICION,
    BLOQUE
;

/* Precedencia de operadores */
precedence left Op_relacional;
precedence left Suma, Resta;
precedence left Multiplicacion, Division;

start with INICIO;

/* Gramática simplificada */
INICIO ::= CLASE;

CLASE ::= 
    Public Class Identificador Llave_a 
        {: ambitos.push("clase"); :}
        CUERPO_CLASE 
        {: ambitos.pop(); :}
    Llave_c
;

CUERPO_CLASE ::=
    Public Static Void Main Parentesis_a Cadena Identificador Parentesis_c 
    Llave_a 
        {: ambitos.push("main"); :}
        SENTENCIAS 
        {: ambitos.pop(); :}
    Llave_c
    | SENTENCIAS
;

SENTENCIAS ::= 
    SENTENCIAS SENTENCIA 
    | SENTENCIA
;

SENTENCIA ::= 
    DECLARACION 
    | ASIGNACION 
    | BLOQUE
;

BLOQUE ::= 
    Llave_a {: ambitos.push("bloque"); :} 
    SENTENCIAS 
    {: ambitos.pop(); :} 
    Llave_c
;

DECLARACION ::= 
    TIPO_VAR:tipo Identificador:id 
    (P_coma 
        {: declararVariable((String)id.value, (String)tipo.value, id.left + 1); :}
    | Igual VALOR:val P_coma 
        {: 
            declararVariable((String)id.value, (String)tipo.value, id.left + 1);
            // Verificación de tipos aquí
        :}
    )
;

TIPO_VAR ::= 
    Int {: RESULT = "int"; :}
    | T_dato {: RESULT = (String)((Symbol)stack(0)).value; :}
    | Cadena {: RESULT = "String"; :}
;

ASIGNACION ::= 
    Identificador:id Op_atribucion VALOR:val P_coma 
        {: 
            verificarVariable((String)id.value, id.left + 1);
            // Verificación de tipos aquí
        :}
;

VALOR ::= 
    Identificador:id 
        {: verificarVariable((String)id.value, id.left + 1); :}
    | Numero 
    | Op_booleano 
    | Comillas Identificador Comillas 
    | Comillas Comillas
;

CONDICION ::= 
    Op_booleano 
    | Identificador:id 
        {: verificarVariable((String)id.value, id.left + 1); :}
    | EXPRESION Op_relacional EXPRESION
;

EXPRESION ::= 
    EXPRESION Suma EXPRESION
    | EXPRESION Resta EXPRESION
    | EXPRESION Multiplicacion EXPRESION
    | EXPRESION Division EXPRESION
    | VALOR
;